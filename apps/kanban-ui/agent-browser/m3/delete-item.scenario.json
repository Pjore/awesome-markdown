{
  "id": "delete-item",
  "version": "2",
  "description": "Delete from the item read view after explicit native confirmation, then return to the originating board.",
  "services": ["kanban-ui:dev"],
  "seed": "m3",
  "url": "http://localhost:5173/?seed=m3",
  "actions": [
    { "type": "navigate", "url": "http://localhost:5173/?seed=m3" },
    { "type": "navigate", "url": "http://localhost:5173/items/m3-item-1?board=m3-demo" },
    { "type": "wait", "selector": "[data-testid='item-properties']" },
    { "type": "click-role", "role": "button", "name": "Delete item" },
    { "type": "dialog-accept" },
    { "type": "wait", "selector": "[data-testid='board']" }
  ],
  "assertions": [
    { "id": "card-removed", "selector": "[data-item-slug='m3-item-1']", "check": "not-exists" }
  ]
}
