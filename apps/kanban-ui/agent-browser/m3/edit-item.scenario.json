{
  "id": "edit-item",
  "version": "2",
  "description": "Read an item, explicitly enter Edit, save properties and document together, remain on the item, and reload without data loss. Live recursive/error/recovery coverage: runner.mjs --live.",
  "services": ["kanban-ui:dev"],
  "seed": "m3",
  "url": "http://localhost:5173/?seed=m3",
  "actions": [
    { "type": "navigate", "url": "http://localhost:5173/?seed=m3" },
    { "type": "navigate", "url": "http://localhost:5173/items/m3-item-1?board=m3-demo" },
    { "type": "wait", "selector": "[data-testid='item-properties']" },
    { "type": "assert-not-exists", "selector": "[data-testid='item-save']" },
    { "type": "click", "selector": "[data-testid='item-edit']" },
    { "type": "fill-label", "label": "title text", "value": "Updated title after edit" },
    {
      "type": "fill",
      "selector": "[data-testid='item-editor-body']",
      "value": "Updated document content"
    },
    { "type": "click", "selector": "[data-testid='item-save']" },
    { "type": "wait-for-gone", "selector": "[data-testid='item-save']" },
    { "type": "reload" }
  ],
  "assertions": [
    {
      "id": "title-persisted",
      "selector": ".item-heading h1",
      "check": "text-contains",
      "value": "Updated title after edit"
    },
    {
      "id": "document-persisted",
      "selector": "[data-testid='item-document']",
      "check": "text-contains",
      "value": "Updated document content"
    },
    { "id": "stays-on-item", "check": "url-contains", "value": "/items/m3-item-1" }
  ]
}
