{
  "id": "create-item",
  "version": "2",
  "description": "Create from a writable cell using its explicit filters. No hidden membership/order write or modal editor.",
  "services": ["kanban-ui:dev"],
  "seed": "m3",
  "url": "http://localhost:5173/?seed=m3",
  "actions": [
    { "type": "navigate", "url": "http://localhost:5173/?seed=m3" },
    { "type": "navigate", "url": "http://localhost:5173/boards/m3-demo" },
    { "type": "wait", "selector": "[data-testid='board']" },
    { "type": "click", "selector": "[data-testid='add-item-m3-todo-m3-frontend']" },
    {
      "type": "fill",
      "selector": "[data-testid='new-item-input-m3-todo-m3-frontend']",
      "value": "New test item from scenario"
    },
    { "type": "click", "selector": "[data-testid='confirm-add-m3-todo-m3-frontend']" }
  ],
  "assertions": [
    {
      "id": "new-card-visible",
      "selector": "[data-testid='item-card-new-test-item-from-scenario']",
      "check": "exists"
    }
  ]
}
